{
  "server": {
    "name": "arive",
    "version": "2.3.0"
  },
  "compression": {
    "enabled": true,
    "thresholdTokens": 2000,
    "maxEntries": 500,
    "previewChars": 600
  },
  "memory": {
    "dbPath": ".arive/memory.db",
    "maxItems": 50000
  },
  "search": {
    "maxResults": 50
  },
  "rag": {
    "dbPath": ".arive/rag.db",
    "chunkChars": 1200,
    "chunkOverlapChars": 200,
    "maxFileBytes": 1000000,
    "maxFiles": 20000,
    "defaultTopK": 8,
    "maxTopK": 50,
    "maxPerFile": 3,
    "maxVectorScan": 50000,
    "embeddings": {
      "provider": "none",
      "apiKeyEnv": "OPENAI_API_KEY",
      "batchSize": 32,
      "timeoutMs": 30000
    }
  },
  "hooks": {
    "enabled": true,
    "maxScanChars": 20000,
    "astTimeoutMs": 3000,
    "onAstError": "skip",
    "guards": [],
    "docs": []
  },
  "downstreams": [
    {
      "namespace": "think",
      "enabled": true,
      "command": "bun",
      "args": [
        "x",
        "--silent",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "connectTimeoutMs": 20000,
      "callTimeoutMs": 60000,
      "compress": true
    },
    {
      "namespace": "lsp",
      "enabled": true,
      "command": "bun",
      "args": ["x", "--silent", "agent-lsp"],
      "connectTimeoutMs": 20000,
      "callTimeoutMs": 120000,
      "compress": true
    },
    {
      "namespace": "dap",
      "enabled": true,
      "command": "bun",
      "args": ["x", "--silent", "dap-mcp"],
      "connectTimeoutMs": 20000,
      "callTimeoutMs": 120000,
      "compress": true
    },
    {
      "namespace": "search",
      "enabled": false,
      "command": "bun",
      "args": ["x", "--silent", "mcp-ripgrep"]
    },
    {
      "namespace": "context",
      "enabled": false,
      "command": "bun",
      "args": ["x", "--silent", "github:headroomlabs-ai/headroom"]
    },
    {
      "namespace": "mem",
      "enabled": false,
      "command": "bun",
      "args": ["x", "--silent", "github:MemPalace/mempalace"]
    },
    {
      "namespace": "rag",
      "enabled": false,
      "command": "uvx",
      "args": ["mcp-server-qdrant"]
    }
  ]
}
